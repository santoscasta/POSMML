# Shopify credentials: configure these only on the server.
SHOPIFY_STORE=your-shop.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternatively, a server-side Admin API access token:
SHOPIFY_ACCESS_TOKEN=

# Required for every API request. Use a unique, long password.
POS_USERNAME=caja
POS_PASSWORD=

# Comma-separated frontend origins, including the deployed HTTPS origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local default: .pos-data. In production, REQUIRED: a persistent mounted volume.
# Railway example: mount a volume at /data and set POS_DATA_DIR=/data/pos-mml.
# Never use the ephemeral deployment filesystem for this value.
POS_DATA_DIR=

# Development frontend points to the Express server; omit in production.
VITE_API_URL=http://localhost:3001/api
